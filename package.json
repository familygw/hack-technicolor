{
  "name": "technicolor-hack",
  "version": "0.0.1",
  "main": "dist/electron-main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "angular:build": "ng build -c 'production' --output-path=./dist",
    "electron:build": "tsc -p tsconfig.electron.json && electron-builder",
    "electron:package": "npm run \"angular:build\" && npm run electron:build",
    "dev:watchts": "tsc -p tsconfig.electron.json -w",
    "dev:start": "cross-env BROWSER=none npm start",
    "dev:run": "wait-on http://localhost:4200 && electron dist/electron-main.js",
    "dev": "concurrently \"npm run dev:watchts\" \"npm run dev:start\" \"npm run dev:run\""
  },
  "private": true,
  "build": {
    "appId": "com.classoft.hacks.technicolor",
    "directories": {
      "output": "release",
      "buildResources": "dist"
    },
    "files": [
      "dist/**/*"
    ]
  },
  "dependencies": {
    "@angular/animations": "^19.2.3",
    "@angular/common": "^19.2.3",
    "@angular/compiler": "^19.2.3",
    "@angular/core": "^19.2.3",
    "@angular/forms": "^19.2.3",
    "@angular/material": "^19.2.4",
    "@angular/platform-browser": "^19.2.3",
    "@angular/platform-browser-dynamic": "^19.2.3",
    "@angular/router": "^19.2.3",
    "axios": "^1.8.4",
    "form-data": "^4.0.2",
    "lodash": "^4.17.21",
    "network": "^0.7.0",
    "rxjs": "~7.8.2",
    "sjcl": "^1.0.8",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.4",
    "@angular/cli": "^19.2.4",
    "@angular/compiler-cli": "^19.2.3",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.13.10",
    "@types/sjcl": "^1.0.34",
    "concurrently": "^9.1.2",
    "cpy-cli": "^5.0.0",
    "cross-env": "^7.0.3",
    "electron": "^35.0.2",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.9",
    "typescript": "^5.8.2",
    "wait-on": "^8.0.3"
  }
}
