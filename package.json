{
  "name": "technicolor-hack",
  "version": "0.0.2",
  "main": "dist/electron-main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "angular:build": "ng build -c 'production' --output-path=./dist",
    "electron:build": "tsc -p tsconfig.electron.json && electron-builder",
    "electron:package": "npm run \"angular:build\" && npm run electron:build",
    "dev:watchts": "tsc -p tsconfig.electron.json -w",
    "dev:start": "cross-env BROWSER=none npm start",
    "dev:run": "wait-on http://localhost:4200 && electron dist/electron-main.js",
    "dev": "concurrently \"npm run dev:watchts\" \"npm run dev:start\" \"npm run dev:run\""
  },
  "private": true,
  "build": {
    "appId": "com.classoft.hacks.technicolor",
    "directories": {
      "output": "release",
      "buildResources": "dist"
    },
    "files": [
      "dist/**/*"
    ]
  },
  "dependencies": {
    "@angular/animations": "^21.2.2",
    "@angular/common": "^21.2.2",
    "@angular/compiler": "^21.2.2",
    "@angular/core": "^21.2.2",
    "@angular/forms": "^21.2.2",
    "@angular/material": "^21.2.1",
    "@angular/platform-browser": "^21.2.2",
    "@angular/platform-browser-dynamic": "^21.2.2",
    "@angular/router": "^21.2.2",
    "axios": "^1.13.6",
    "form-data": "^4.0.5",
    "lodash": "^4.17.23",
    "network": "^0.7.0",
    "rxjs": "~7.8.2",
    "sjcl": "^1.0.8",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.4.0",
    "@types/sjcl": "^1.0.34",
    "concurrently": "^9.2.1",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.4"
  }
}
