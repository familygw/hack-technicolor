# Modem connection
MODEM_IP=172.18.40.1
MODEM_USERNAME=custadmin
MODEM_PASSWORD=replace-me

# Target selection
# Preferred: match target SSIDs by prefix, case-insensitive.
TARGET_SSID_PREFIXES="personal,flow,zona wifi"

# Optional fallback: match target SSIDs by substring, case-insensitive.
# TARGET_SSID_MATCHERS="personal wifi zone,zona wifi"

# Optional override if you already know the exact modem entry number.
# TARGET_WIFI_IDS=9

# Scheduler
CHECK_INTERVAL_MINUTES=60
RUN_ON_START=true
INITIAL_DELAY_MINUTES=15

# The modem only applies disable reliably after an enable pulse.
ENABLE_DISABLE_DELAY_MS=5000

# Runtime
REQUEST_TIMEOUT_MS=15000
WIFI_UPDATE_TIMEOUT_MS=45000
DRY_RUN=false